# Environment template for Azimutree

# Copy this file to `.env`, provide the required values, and keep the resulting
# `.env` file out of version control.

# Mapbox access token (public key). Required for Mapbox map rendering.

# Example: pk.eyJ1IjoieW91cnVzZXIiLCJhIjoiY2t...

MAP_BOX_ACCESS=

# Mapbox style URI for the standard (street) map style.

# Example: mapbox://styles/yourusername/your-style-id

MAPBOX_STYLE_STANDARD=

# Mapbox style URI for the satellite map style.

# Example: mapbox://styles/yourusername/your-satellite-style-id

MAPBOX_STYLE_SATELLITE=

# Public URL for downloading the Excel import template.

# If not set, the app will show a warning and refuse to open the template.

# Example: https://azimutree.heavysnack.my.id/template/

TEMPLATE_URL=https://azimutree.heavysnack.my.id/template/

# Public URL for downloading sample data while Debug Mode is enabled.

SAMPLE_DATA_URL=https://azimutree.heavysnack.my.id/sample-data/

# Firebase client API keys generated for each supported platform.

# These values are required by `lib/firebase_options.dart`. Firebase API keys
# identify the project; access control must still be enforced with Firebase
# Authentication, Firestore Security Rules, and API key restrictions.

FIREBASE_API_KEY_ANDROID=
FIREBASE_API_KEY_WEB=
FIREBASE_API_KEY_APPLE=

# Notes for developers:

# - Update `.env` with real values before running the app.

# - The app reads these values through `flutter_dotenv` at runtime.

# - Never place private server credentials or service-account keys in `.env`.
