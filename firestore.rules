rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /system/status {
      allow read: if true;
      allow write: if false;
    }

    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;

      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'displayName', 'email', 'createdAt', 'updatedAt', 'lastLoginAt'
        ])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 20
        && request.resource.data.email is string;

      allow update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'email', 'updatedAt', 'lastLoginAt'
        ])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 20
        && request.resource.data.email is string;

      allow delete: if false;
    }

    match /researchLocations/{locationId} {
      allow read: if resource.data.isPublic == true
        || (request.auth != null && resource.data.ownerId == request.auth.uid);

      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly([
          'ownerId', 'ownerName', 'name', 'nameKey', 'researchDate', 'isPublic',
          'clusterCount', 'clusterCodes', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerName is string
        && request.resource.data.name is string
        && request.resource.data.nameKey is string
        && request.resource.data.researchDate is timestamp
        && request.resource.data.isPublic is bool
        && request.resource.data.clusterCount == 0
        && request.resource.data.clusterCodes is list
        && request.resource.data.clusterCodes.size() == 0
        && existsAfter(
          /databases/$(database)/documents/researchLocationNames/$(request.resource.data.nameKey)
        )
        && getAfter(
          /databases/$(database)/documents/researchLocationNames/$(request.resource.data.nameKey)
        ).data.locationId == locationId
        && getAfter(
          /databases/$(database)/documents/researchLocationNames/$(request.resource.data.nameKey)
        ).data.ownerId == request.auth.uid;

      allow update: if request.auth != null
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'ownerName', 'name', 'researchDate', 'isPublic', 'clusterCount',
          'clusterCodes', 'updatedAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.ownerName is string
        && request.resource.data.researchDate is timestamp
        && request.resource.data.isPublic is bool
        && request.resource.data.clusterCount is int
        && request.resource.data.clusterCount >= 0
        && request.resource.data.clusterCodes is list
        && request.resource.data.clusterCount == request.resource.data.clusterCodes.size();

      allow delete: if request.auth != null
        && resource.data.ownerId == request.auth.uid
        && resource.data.clusterCount == 0;

      match /clusters/{clusterId} {
        allow read: if get(
          /databases/$(database)/documents/researchLocations/$(locationId)
        ).data.isPublic == true
          || (request.auth != null && get(
            /databases/$(database)/documents/researchLocations/$(locationId)
          ).data.ownerId == request.auth.uid);
        allow create, update: if request.auth != null
          && get(
            /databases/$(database)/documents/researchLocations/$(locationId)
          ).data.ownerId == request.auth.uid
          && request.resource.data.keys().hasOnly([
            'code', 'surveyorName', 'surveyDate', 'anchor', 'plots', 'uploadedAt'
          ])
          && request.resource.data.code is string
          && request.resource.data.code.size() >= 1
          && request.resource.data.code.size() <= 30
          && request.resource.data.plots is list;

        allow delete: if request.auth != null
          && get(
            /databases/$(database)/documents/researchLocations/$(locationId)
          ).data.ownerId == request.auth.uid;
      }
    }

    match /researchLocationNames/{nameKey} {
      allow get: if request.auth != null;
      allow list: if false;

      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly([
          'locationId', 'ownerId', 'name', 'createdAt'
        ])
        && request.resource.data.locationId is string
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.name is string
        && existsAfter(
          /databases/$(database)/documents/researchLocations/$(request.resource.data.locationId)
        )
        && getAfter(
          /databases/$(database)/documents/researchLocations/$(request.resource.data.locationId)
        ).data.ownerId == request.auth.uid
        && getAfter(
          /databases/$(database)/documents/researchLocations/$(request.resource.data.locationId)
        ).data.nameKey == nameKey;

      allow update: if false;

      allow delete: if request.auth != null
        && resource.data.ownerId == request.auth.uid
        && !existsAfter(
          /databases/$(database)/documents/researchLocations/$(resource.data.locationId)
        );
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
