rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /system/status {
      allow read: if true;
      allow write: if false;
    }

    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;

      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'displayName', 'email', 'createdAt', 'updatedAt', 'lastLoginAt'
        ])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 80
        && request.resource.data.email is string;

      allow update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'email', 'updatedAt', 'lastLoginAt'
        ])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 80
        && request.resource.data.email is string;

      allow delete: if false;
    }

    match /researchLocations/{locationId} {
      allow read: if resource.data.isPublic == true
        || (request.auth != null && resource.data.ownerId == request.auth.uid);
      allow write: if false;

      match /clusters/{clusterId} {
        allow read: if get(
          /databases/$(database)/documents/researchLocations/$(locationId)
        ).data.isPublic == true
          || (request.auth != null && get(
            /databases/$(database)/documents/researchLocations/$(locationId)
          ).data.ownerId == request.auth.uid);
        allow write: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
